{
  "protocol": "hermes_tau2_airline_openviking.v1",
  "domain": "airline",
  "train_split": "train",
  "eval_split": "test",
  "train_tasks": 30,
  "eval_tasks": 20,
  "seeds": [300, 301, 302, 303],
  "max_steps": 200,
  "simulation_timeout": 900,
  "agent_request_timeout": 180,
  "max_retries": 0,
  "task_concurrency": 1,
  "agent_model": "deepseek-v4-flash",
  "user_model": "openai/deepseek-v4-flash",
  "temperature": 0,
  "user_simulator_policy": "confirmation_aware",
  "max_agent_iterations": 90,
  "openviking_url": "http://127.0.0.1:1933",
  "openviking_account": "default-hermes-airline-trajectory-async-loop-v2",
  "openviking_user": "tau2-airline-hermes-trajectory-async-loop-v2",
  "corpus_revision": "async-loop-v2",
  "search_uri": "viking://user/memories/trajectories",
  "first_user_top_k": 4,
  "prewrite_top_k": 2,
  "memory_inject_max_chars": 16000,
  "openviking_timeout": 120,
  "openviking_wait_timeout": 900,
  "write_tool_prefixes": [
    "toggle_", "enable_", "disable_", "set_", "reset_", "update_",
    "modify_", "cancel_", "book_", "exchange_", "return_", "grant_", "reboot_"
  ]
}
